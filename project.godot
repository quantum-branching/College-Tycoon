config_version=5

[application]

config/name="College Tycoon"
config/version="0.0.0"
run/main_scene="res://Scenes/Start Screen.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="uid://bkske07nk6rqn"

[autoload]

